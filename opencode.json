{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "${CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "enabled": true,
      "type": "local",
      "command": [
        "npx",
        "@playwright/mcp@latest"
      ]
    },
    "mastra": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mastra/mcp-docs-server"
      ],
      "enabled": false
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "git push": "deny",
      "npm *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "bun *": "allow",
      "python *": "allow",
      "pip *": "allow",
      "pytest *": "allow",
      "cargo *": "allow",
      "go *": "allow",
      "composer *": "allow",
      "bundle *": "allow",
      "rm -rf *": "ask",
      "mv *": "ask",
      "*": "allow"
    },
    "webfetch": "ask"
  },
}
