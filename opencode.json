{
  "$schema": "https://opencode.ai/config.json",
  "tui": {
    "scroll_acceleration": {
      "enabled": true
    }
  },
  "mcp": {
    "context7": {
      "enabled": true,
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    },
    "playwright": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"]
    },
    "mastra": {
      "enabled": false,
      "type": "local",
      "command": ["npx", "-y", "@mastra/mcp-docs-server"]
    }
  },
  "permission": {
    "edit": "allow",
    "bash": {
      "git *": "allow",
      "git push": "deny",
      "npm *": "allow",
      "pnpm *": "allow",
      "yarn *": "allow",
      "bun *": "allow",
      "python *": "allow",
      "pip *": "allow",
      "pytest *": "allow",
      "cargo *": "allow",
      "go *": "allow",
      "composer *": "allow",
      "bundle *": "allow",
      "rm -rf *": "ask",
      "mv *": "ask",
      "*": "allow"
    },
    "webfetch": "ask"
  },
  "agent": {
    "explore": {
      "model": "github-copilot/gpt-4.1"
    }
  }
}
